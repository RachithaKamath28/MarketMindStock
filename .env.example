# Flask session signing key: generate with python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL connection string. Leave blank for local SQLite fallback.
DATABASE_URL=

# Private review-admin credentials (set both; never commit real values)
REVIEWS_ADMIN_USER=admin
REVIEWS_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional local Ollama sentiment classification
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
